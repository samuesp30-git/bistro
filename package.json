{
  "name": "bistro",
  "version": "0.1.0",
  "private": true,
  "description": "Restaurant ordering app and staff admin panel. Next.js web client, Node.js REST API, PostgreSQL.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @bistro/web",
    "build": "npm run build -w @bistro/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
