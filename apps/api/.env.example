# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---------- Database ----------
# Neon gives you two connection strings. Use the POOLED one (host contains
# "-pooler") for the running app, and the UNPOOLED one for migrations:
# Prisma Migrate cannot run through a transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/bistro?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/bistro?sslmode=require"

# With the docker compose database, both point at that container instead. There
# is no pooler in front of it, so the two URLs are identical.
#
# Running from the host (npm run dev, npx prisma migrate dev) the host is
# "localhost", because compose publishes the port:
# DATABASE_URL="postgresql://bistro:bistro@localhost:5432/bistro?schema=public"
# DIRECT_URL="postgresql://bistro:bistro@localhost:5432/bistro?schema=public"
#
# Running inside the compose network the host is the service name "db" instead.
# That value belongs in docker-compose.yml, not in this file.

# ---------- Server ----------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Origin allowed to call this API, and the base URL PayPal redirects back to.
WEB_ORIGIN="http://localhost:3000"
PUBLIC_WEB_URL="http://localhost:3000"

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

# ---------- PayPal (sandbox) ----------
# Not Stripe: Stripe does not operate in Honduras, and in Latin America supports
# only Brazil and Mexico.
#
# All three are optional. Without them the API still boots and orders are still
# placed — they arrive as PENDING_PAYMENT and are paid on collection, which is how
# the restaurant works anyway. Only the online payment step is skipped.
#
# From developer.paypal.com -> Apps & Credentials -> Sandbox -> your app.
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# The webhook's id, shown after you create the webhook in that same app. It is
# part of the signed message, so a wrong value makes every delivery fail the
# signature check with nothing else to distinguish it from a forgery.
#
# TESTING NOTE: PayPal's Webhooks Simulator signs its events against the literal
# string WEBHOOK_ID rather than your real one. To exercise the handler with the
# simulator, set this to WEBHOOK_ID temporarily. Real deliveries then fail until
# you put the real value back, so do not leave it that way.
PAYPAL_WEBHOOK_ID=""

# PayPal cannot deliver to localhost. For local testing, expose the API with a
# tunnel and register <tunnel>/api/webhooks/paypal as the webhook URL:
#   cloudflared tunnel --url http://localhost:4000

# ---------- Seeding ----------
# Only needed when running `npm run db:seed`. No default password exists in the
# repository on purpose; the seed throws if these are unset.
SEED_ADMIN_EMAIL="owner@bistro.example"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Bistro Owner"
