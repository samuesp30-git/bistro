# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---------- Database ----------
# Neon gives you two connection strings. Use the POOLED one (host contains
# "-pooler") for the running app, and the UNPOOLED one for migrations:
# Prisma Migrate cannot run through a transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/bistro?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/bistro?sslmode=require"

# With docker compose both point at the local container instead:
# DATABASE_URL="postgresql://bistro:bistro@db:5432/bistro?schema=public"
# DIRECT_URL="postgresql://bistro:bistro@db:5432/bistro?schema=public"

# ---------- Server ----------
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Origin allowed to call this API, and the base URL Stripe redirects back to.
WEB_ORIGIN="http://localhost:3000"
PUBLIC_WEB_URL="http://localhost:3000"

# ---------- Auth ----------
# Generate with: openssl rand -base64 48
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="12h"

# ---------- Stripe (test mode) ----------
STRIPE_SECRET_KEY="sk_test_..."
# NOTE: this differs per environment. Locally it is what `stripe listen` prints;
# in production it is the signing secret of the dashboard webhook endpoint.
# Mixing them up gives "No signatures found matching the expected signature".
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------- Seeding ----------
# Only needed when running `npm run db:seed`. No default password exists in the
# repository on purpose; the seed throws if these are unset.
SEED_ADMIN_EMAIL="owner@bistro.example"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Bistro Owner"
