# Copy to .env.local for local development. .env.local is gitignored.

# Where the server-side render reaches the REST API.
#
# Server-only: no NEXT_PUBLIC_ prefix, so it is never inlined into the browser
# bundle. The browser calls the relative /api/... path instead, which
# next.config.ts rewrites to this same API.
#
# Defaults to http://localhost:4000, so local development needs no value here.
# In production this is the deployed API's URL.
API_INTERNAL_URL="http://localhost:4000"

# Canonical origin used by metadata, Open Graph and the JSON-LD.
#
# Unset, the site falls back to a placeholder, so the canonical tags of a real
# deployment will be wrong until this is set. On Vercel it can be derived from
# VERCEL_PROJECT_PRODUCTION_URL instead.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
